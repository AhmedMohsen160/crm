// ═══════════════════════════════════════════════════════════════
//  Fast Trans CRM — مخطط قاعدة البيانات
//  كل "model" هنا = جدول في قاعدة البيانات (مثل شيت في إكسل)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
//  المستخدمون والصلاحيات
// ───────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  jobTitle     String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // الدور مرجع إلى جدول الأدوار — الصلاحيات بيانات لا كود
  roleId  String?
  roleRef Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  /// فرع الموظف — يُقيّد رؤيته حسب إعداد النظام
  branch String?

  /// المدير المباشر — عليه يقوم نطاق رؤية الفريق وحصة النسب
  reportsToId String?
  reportsTo   User?   @relation("UserManager", fields: [reportsToId], references: [id], onDelete: SetNull)
  team        User[]  @relation("UserManager")

  /// هل ينتج فعليًا (يترجم/يراجع)؟ مستقل تمامًا عن الدور
  isProducer Boolean @default(false)

  // العلاقات
  ownedCompanies Company[]  @relation("CompanyOwner")
  ownedContacts  Contact[]  @relation("ContactOwner")
  ownedLeads     Lead[]     @relation("LeadOwner")
  ownedDeals     Deal[]     @relation("DealOwner")
  assignedTasks  Task[]     @relation("TaskAssignee")
  createdTasks   Task[]     @relation("TaskCreator")
  notes          Note[]
  activities     Activity[]
  quotes         Quote[]
  auditEntries   AuditLog[]
  ownedClients   Client[]   @relation("ClientOwner")
  createdClients Client[]   @relation("ClientCreator")

  @@index([email])
  @@index([reportsToId])
  @@index([branch])
}

// ───────────────────────────────────────────────
//  الأدوار والصلاحيات — بيانات لا كود
// ───────────────────────────────────────────────

/// دور يُنشأ ويُعدَّل من الشاشة بلا نشر جديد.
/// الكود يفحص الصلاحية لا اسم الدور.
model Role {
  id        String  @id @default(cuid())
  name      String  @unique /// مفتاح إنجليزي ثابت
  label     String /// الاسم المعروض بالعربية
  isSystem  Boolean @default(false) /// أدوار النظام لا تُحذف
  sortOrder Int     @default(0)

  // ── الصلاحيات الثماني عشرة (§٥ من المواصفة) ──
  canCreateLead           Boolean @default(false)
  canViewAllLeads         Boolean @default(false)
  canViewTeamLeads        Boolean @default(false)
  canConvertProject       Boolean @default(false)
  canViewSellPrice        Boolean @default(false)
  canDiscount             Boolean @default(false)
  canApproveDiscount      Boolean @default(false)
  canAssignProduction     Boolean @default(false)
  canViewFreelancerCost   Boolean @default(false)
  canViewStaffSalary      Boolean @default(false)
  canViewCostIndicator    Boolean @default(false)
  canRecordCollection     Boolean @default(false)
  canManageFreelancers    Boolean @default(false)
  canPayFreelancers       Boolean @default(false)
  canManageUsers          Boolean @default(false)
  canManageSettings       Boolean @default(false)
  canViewCompanyAnalytics Boolean @default(false)
  canViewTeamAnalytics    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// ───────────────────────────────────────────────
//  القوائم المرجعية — تُدار من الشاشة
// ───────────────────────────────────────────────

/// كل قائمة منسدلة في النظام: الفروع، القنوات، أنماط التشغيل، خطوط الخدمة...
/// الحقل extra يحمل المعامل حيث ينطبق (معامل الجهد أو التخصص).
model ListItem {
  id        String  @id @default(cuid())
  listName  String /// اسم القائمة: branch | channel | work_mode | service_line ...
  value     String /// المفتاح الإنجليزي
  label     String /// المعروض بالعربية
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  extra     String? /// المعامل رقمًا نصيًا

  @@unique([listName, value])
  @@index([listName, active])
}

// ───────────────────────────────────────────────
//  سجل التدقيق — لا شيء يُمحى
// ───────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  action    String /// CREATE | UPDATE | DELETE | LOGIN ...
  tableName String
  recordId  String
  field     String?
  oldValue  String?
  newValue  String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@index([ts])
}

// ───────────────────────────────────────────────
//  الشركات (الحسابات) — العميل المؤسسي
// ───────────────────────────────────────────────

model Company {
  id           String   @id @default(cuid())
  name         String
  nameAr       String?
  industry     String? // القطاع: محاماة، طبي، حكومي...
  website      String?
  phone        String?
  email        String?
  country      String?
  city         String?
  address      String?
  taxNumber    String? // الرقم الضريبي / السجل التجاري
  paymentTerms String? // شروط الدفع: فوري، 30 يوم...
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId String?
  owner   User?   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  contacts   Contact[]
  clients    Client[]
  deals      Deal[]
  tasks      Task[]
  noteItems  Note[]
  quotes     Quote[]
  activities Activity[]

  @@index([name])
  @@index([ownerId])
}

// ───────────────────────────────────────────────
//  جهات الاتصال — الأشخاص داخل الشركات
// ───────────────────────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  mobile    String?
  jobTitle  String?
  language  String? // لغة التواصل المفضلة
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  deals      Deal[]
  tasks      Task[]
  noteItems  Note[]
  quotes     Quote[]
  activities Activity[]

  @@index([email])
  @@index([companyId])
  @@index([ownerId])
}

// ───────────────────────────────────────────────
//  العملاء المحتملون (Leads) — قبل التأهيل
// ───────────────────────────────────────────────

// ───────────────────────────────────────────────
//  العملاء — كائن واحد يخدم الفرد والشركة
//  «لا يُنشأ عميل مكرر أبدًا» (§4.1)
// ───────────────────────────────────────────────

model Client {
  id   String  @id @default(cuid())
  /// معرّف تسلسلي دائم بصيغة CL-00001.
  /// اختياري في السكيما لا في السلوك: كل سجل يُنشأ من النظام يحصل عليه فورًا،
  /// والاختيارية موجودة ليستطيع النشر إضافة العمود على جدول فيه صفوف قديمة
  /// ثم يملؤها التجهيز. راجع backfillCodes في scripts/bootstrap.ts.
  code String? @unique
  name String

  /// الهاتف كما أدخله المستخدم — للعرض والاتصال
  phone              String
  /// الهاتف بعد التطبيع السباعي (§١٤) — **مفتاح منع الازدواج**
  phoneNormalized    String  @unique
  phoneAlt           String?
  /// المطبَّع للهاتف البديل — يدخل البحث ولا يمنع الازدواج
  phoneAltNormalized String?

  email String?
  /// individual | company
  type  String  @default("individual")

  companyName String?
  taxId       String?
  country     String?
  city        String?
  /// الفرع الذي جاء منه أول مرة — لا يتغيّر
  firstBranch String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("ClientCreator", fields: [createdById], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// ربط اختياري بسجل الشركة (الرقم الضريبي وشروط الدفع)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  leads Lead[]
  deals Deal[]

  @@index([phoneNormalized])
  @@index([phoneAltNormalized])
  @@index([name])
  @@index([ownerId])
  @@index([firstBranch])
}

// ───────────────────────────────────────────────
//  عدّادات المعرّفات التسلسلية
// ───────────────────────────────────────────────

/// مفتاح واحد لكل سلسلة: "client" عام، و"lead-2608" يتجدّد شهريًا.
/// التخصيص يتم داخل معاملة حتى لا يحصل شخصان على الرقم نفسه.
model Counter {
  key   String @id
  value Int    @default(0)
}

model Lead {
  id              String    @id @default(cuid())
  /// معرّف تسلسلي بصيغة LD-2608-0001 — العدّاد يتجدّد شهريًا.
  /// اختياري في السكيما لا في السلوك (انظر التعليق على Client.code).
  code            String?   @unique
  firstName       String
  lastName        String?
  companyName     String?
  email           String?
  phone           String?
  source          String? // مصدر قديم — يُستبدل تدريجيًا بـ channel
  status          String    @default("NEW") // NEW | CONTACTED | QUOTED | NEGOTIATION | WON | LOST
  serviceInterest String? // نوع الخدمة المطلوبة
  sourceLang      String?
  targetLang      String?
  estimatedValue  Float?
  notes           String?
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// قناة وصول الليد — إلزامية (§4.2)
  channel       String?
  /// وسيلة التواصل: واتساب | اتصال | إيميل | مقر
  contactMethod String?
  /// فرع الليد — يُملأ تلقائيًا من فرع المستخدم المُنشئ
  branch        String?
  /// عدد الصفحات التقديري
  estPages      Float?

  /// أول انتقال عن «جديد» — منه تُقاس سرعة الرد وقياس الـSLA
  firstReplyAt DateTime?
  /// وقت الحسم فوزًا أو خسارة
  closedAt     DateTime?
  /// إلزامي عند الخسارة — بلا سبب لا نتعلّم شيئًا
  lossReason   String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasks      Task[]
  noteItems  Note[]
  activities Activity[]

  @@index([status])
  @@index([ownerId])
  @@index([clientId])
  @@index([branch])
  @@index([createdAt])
}

// ───────────────────────────────────────────────
//  الصفقات / الفرص البيعية
// ───────────────────────────────────────────────

model Deal {
  id          String  @id @default(cuid())
  title       String
  description String?
  stage       String  @default("NEW") // NEW | QUOTED | NEGOTIATION | WON | LOST
  amount      Float   @default(0)
  currency    String  @default("EGP")
  probability Int     @default(20) // نسبة احتمال الإغلاق %

  // حقول خاصة بمكتب الترجمة
  serviceType  String? // ترجمة معتمدة، فورية، توطين، تدقيق...
  sourceLang   String?
  targetLang   String?
  wordCount    Int?
  pageCount    Int?
  deliveryDate DateTime?

  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// العميل صاحب الصفقة — أساس بطاقة العميل وتاريخ مشترياته
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasks      Task[]
  noteItems  Note[]
  quotes     Quote[]
  activities Activity[]

  @@index([stage])
  @@index([ownerId])
  @@index([companyId])
  @@index([clientId])
}

// ───────────────────────────────────────────────
//  المهام
// ───────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  type        String    @default("TODO") // CALL | EMAIL | MEETING | FOLLOW_UP | TODO
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId String?
  creator   User?   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  // المهمة قد ترتبط بأي كيان
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status])
  @@index([dueDate])
}

// ───────────────────────────────────────────────
//  الملاحظات
// ───────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ───────────────────────────────────────────────
//  عروض الأسعار
// ───────────────────────────────────────────────

model Quote {
  id         String    @id @default(cuid())
  number     String    @unique // QT-2026-0001
  title      String
  status     String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED
  currency   String    @default("EGP")
  subtotal   Float     @default(0)
  discount   Float     @default(0)
  taxRate    Float     @default(0)
  taxAmount  Float     @default(0)
  total      Float     @default(0)
  validUntil DateTime?
  notes      String?
  terms      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items QuoteItem[]

  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status])
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  serviceType String?
  sourceLang  String?
  targetLang  String?
  unit        String  @default("WORD") // WORD | PAGE | HOUR | PROJECT
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  lineTotal   Float   @default(0)
  sortOrder   Int     @default(0)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// ───────────────────────────────────────────────
//  سجل الأنشطة (من فعل ماذا ومتى)
// ───────────────────────────────────────────────

model Activity {
  id        String   @id @default(cuid())
  type      String // CREATED | UPDATED | STAGE_CHANGED | NOTE_ADDED | EMAIL_SENT | CALL_LOGGED
  title     String
  detail    String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ───────────────────────────────────────────────
//  إعدادات النظام (أسعار اللغات، إلخ)
// ───────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  /// الاسم العربي المعروض في شاشة الإعدادات
  label     String?
  updatedAt DateTime @updatedAt
}

model PriceRate {
  id          String  @id @default(cuid())
  serviceType String // ترجمة معتمدة، تدقيق...
  sourceLang  String
  targetLang  String
  unit        String  @default("WORD")
  price       Float
  currency    String  @default("EGP")
  active      Boolean @default(true)

  @@unique([serviceType, sourceLang, targetLang, unit])
}
