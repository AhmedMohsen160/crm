{
  "name": "fasttrans-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm install && prisma migrate dev --name init && npm run bootstrap && npm run db:seed",
    "test:e2e": "node tests/e2e.mjs",
    "predev": "node scripts/db-provider.mjs",
    "prebuild": "node scripts/db-provider.mjs",
    "db:deploy": "node scripts/db-provider.mjs && prisma generate && prisma db push --accept-data-loss",
    "vercel-build": "node scripts/db-provider.mjs && prisma generate && prisma db push --skip-generate --accept-data-loss && tsx scripts/bootstrap.ts && next build",
    "bootstrap": "node scripts/db-provider.mjs && prisma generate && tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.5.18",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^9.1.0"
  }
}
