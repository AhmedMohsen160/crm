{
  "name": "fasttrans-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm install && prisma migrate dev --name init && npm run bootstrap && npm run db:seed",
    "test:e2e": "node tests/e2e.mjs",
    "predev": "node scripts/db-provider.mjs",
    "prebuild": "node scripts/db-provider.mjs",
    "db:deploy": "node scripts/db-provider.mjs && prisma generate && prisma db push --accept-data-loss",
    "vercel-build": "node scripts/db-provider.mjs && node scripts/check-additive.mjs && prisma generate && prisma db push --skip-generate --accept-data-loss && tsx scripts/bootstrap.ts && next build",
    "bootstrap": "node scripts/db-provider.mjs && prisma generate && tsx scripts/bootstrap.ts",
    "test:phone": "tsx tests/phone.mjs",
    "test:costing": "tsx tests/costing.mjs",
    "test:unit": "npm run test:phone && npm run test:costing && npm run test:permissions && npm run test:commission && npm run test:freelancers && npm run test:accounting && npm run test:migration && npm run test:import-accounting && npm run test:notifications && npm run test:proposals && npm run test:email && npm run test:ai && npm run test:hr && npm run test:budget && npm run test:quote-design && npm run test:files && npm run test:branch-economics && npm run check:additive",
    "test:commission": "tsx tests/commission.mjs",
    "test:freelancers": "tsx tests/freelancers.mjs",
    "test:accounting": "tsx tests/accounting.mjs",
    "test:migration": "tsx tests/migration.mjs",
    "test:notifications": "tsx tests/notifications.mjs",
    "notify": "tsx scripts/notify.ts",
    "test:proposals": "tsx tests/proposals.mjs",
    "test:email": "tsx tests/email.mjs",
    "test:ai": "tsx tests/ai.mjs",
    "test:hr": "tsx tests/hr.mjs",
    "test:budget": "tsx tests/budget.mjs",
    "test:quote-design": "tsx tests/quote-design.mjs",
    "test:files": "tsx tests/files.mjs",
    "test:branch-economics": "tsx tests/branch-economics.mjs",
    "test:permissions": "tsx tests/permissions.mjs",
    "test:import-accounting": "tsx tests/import-accounting.mjs",
    "check:additive": "node scripts/check-additive.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "imapflow": "^1.6.5",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "mailparser": "^3.9.14",
    "next": "^15.5.22",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.5.18",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^9.1.0"
  }
}
