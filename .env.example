# ═══════════════════════════════════════════════
#  إعدادات نظام Fast Trans CRM
#  انسخ هذا الملف باسم .env ثم عدّل القيم
# ═══════════════════════════════════════════════

# مكان قاعدة البيانات (اتركه كما هو)
DATABASE_URL="file:./dev.db"

# مفتاح تشفير جلسات الدخول — غيّره لأي نص عشوائي طويل
AUTH_SECRET="ghayyir-hatha-alnass-ila-nass-aashwaiy-taweel-jiddan-2026"

# اسم شركتك (يظهر في الواجهة وعروض الأسعار)
NEXT_PUBLIC_COMPANY_NAME="Fast Trans Translation Office"
NEXT_PUBLIC_COMPANY_NAME_AR="مكتب فاست ترانس للترجمة"

# ═══════════════════════════════════════════════
#  البريد والذكاء الاصطناعي  (اختيارية — النظام يعمل بدونها)
# ═══════════════════════════════════════════════

# مفتاح تعمية أسرار صناديق البريد.
# اتركه فارغًا ليُشتقّ من AUTH_SECRET، أو اضبط مفتاحًا مستقلًّا (١٦ حرفًا فأكثر)
# SECRET_KEY=""

# مفتاح الذكاء الاصطناعي — بدونه تختفي الأزرار الذكية ويعمل الباقي كاملًا
# ANTHROPIC_API_KEY=""

# النموذج وسقف الإنفاق اليومي بالدولار (٠ = بلا حد)
# AI_MODEL="claude-sonnet-4-5"
# AI_DAILY_BUDGET_USD="5"

# سرّ المهام المجدوَلة (سحب البريد + توليد التنبيهات) على /api/cron
# بدونه يبقى المسار **مغلقًا** — وهو الافتراض الآمن
# CRON_SECRET=""
